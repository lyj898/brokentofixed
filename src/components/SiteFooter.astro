---
/**
 * Site footer. No links to the sister sites here: the family rules forbid
 * sitewide or footer links between them. The one exception is "Part of
 * OurKampung" (family revamp, 5 Oct 2026), marked nofollow so it is for
 * readers, not rankings, and never noreferrer so GA4 still credits the visit.
 * No company is named (independence, 6 Oct 2026).
 */
import Wordmark from './Wordmark.astro';
import { company, jobs } from '../lib/data';
import { urls } from '../lib/urls';

const year = new Date().getFullYear();
const link = 'text-sm text-ink-muted no-underline hover:text-brand';
---

<div aria-hidden="true" class="h-16 bg-[url(/illo/toolstrip.svg)] bg-[length:auto_64px] bg-bottom bg-repeat-x"></div>
<footer class="border-t border-line bg-surface-sunk">
  <div class="wrap py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Wordmark class="text-base" />
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-muted">{company.businessModelStatement}</p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink">Handyman jobs</h2>
        <ul class="mt-3 space-y-2">
          <li><a href={urls.handyman()} class={link}>All handyman jobs</a></li>
          {jobs.map((j) => (
            <li><a href={urls.job(j.slug)} class={link}>{j.serviceName}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink">BrokenToFixed</h2>
        <ul class="mt-3 space-y-2">
          <li><a href={urls.howItWorks()} class={link}>How it works</a></li>
          <li><a href={urls.about()} class={link}>About</a></li>
          <li><a href={urls.contact()} class={link}>Contact</a></li>
          <li><a href={urls.privacy()} class={link}>Privacy policy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-8 text-sm leading-relaxed text-ink-muted">
      <p>
        {company.tradingName} is run by {company.team}.
        The work is done by independent partner handymen.
      </p>
      <p class="mt-1">{company.operatingHoursDisplay}</p>
      <p class="mt-4">
        Part of <a href={company.links.ourKampung} rel="nofollow" class="text-ink-muted underline underline-offset-2 hover:text-brand">OurKampung</a>.
      </p>
      <p class="mt-6 text-2xs text-ink-faint">&copy; {year} {company.tradingName}.</p>
    </div>
  </div>
</footer>
