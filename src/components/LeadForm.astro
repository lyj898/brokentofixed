---
/**
 * Enquiry form. AJAX POST to FormSubmit, like PestToClear's, to the family
 * enquiry standard (jtc-family/PORTFOLIO.md, "Enquiries"):
 *
 * - The subject carries the site and the page ("BrokenToFixed – Furniture
 *   assembly") so enquiries can be counted per site and per page from the inbox.
 * - `generate_lead` fires once, only after FormSubmit confirms delivery.
 * - The PDPA notice says exactly where the details go.
 * - If sending fails, the message says so and everything typed stays in place.
 *   No contact details are offered instead (family-wide since 2 Oct 2026).
 * - The endpoint comes from PUBLIC_FORM_ENDPOINT when set (src/lib/contact.ts).
 *
 * Jobs are checkboxes, because one visit often covers several. One form per
 * page: the script looks the form up by data attribute.
 *
 * Everything inside the inline <script> below is public page source, so notes
 * like these belong here, not in there.
 */
import { FORM_ENDPOINT, formSubject } from '../lib/contact';
import { company, jobs } from '../lib/data';
import { urls } from '../lib/urls';

interface Props {
  /** Page name for the email subject. */
  pageName: string;
  /** Job slug to pre-tick, on a job page. */
  job?: string;
}

const { pageName, job = '' } = Astro.props;
const subject = formSubject(pageName);
const site = company.tradingName;

const jobOptions = [
  ...jobs.map((j) => ({ value: j.name, slug: j.slug })),
  { value: 'Something else', slug: 'other' },
];
const propertyOptions = ['HDB flat', 'Condo', 'Landed house', 'Office', 'Other premises'];
const timingOptions = ['As soon as possible', 'Within a week', 'Within a month', 'Just comparing for now'];

const field =
  'mt-1.5 w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-base text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/25';
const label = 'block text-sm font-medium text-ink';
const optional = 'font-normal text-ink-faint';
---

<div data-lead-region>
<form data-lead-form novalidate class="space-y-5">
  <fieldset>
    <legend class={label}>What needs doing? <span class={optional}>(tick all that apply)</span></legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      {jobOptions.map((o) => (
        <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-sm text-ink has-[:checked]:border-brand has-[:checked]:bg-brand-light/60">
          <input type="checkbox" name="Jobs" value={o.value} checked={o.slug === job} class="size-4 accent-brand" />
          <span>{o.value}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div>
    <label class={label} for="lf-details">Describe the job</label>
    <textarea
      id="lf-details"
      name="Details"
      rows="3"
      class={field}
      required
      placeholder="e.g. Mount a 55-inch TV on a concrete wall, and fix a kitchen tap that drips."
    ></textarea>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="lf-property">Property type</label>
      <select id="lf-property" name="Property" class={field} required>
        <option value="" selected>Choose one</option>
        {propertyOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
    <div>
      <label class={label} for="lf-area">Area <span class={optional}>(town or estate)</span></label>
      <input id="lf-area" name="Area" type="text" class={field} autocomplete="address-level2" placeholder="e.g. Toa Payoh" />
    </div>
  </div>

  <div>
    <label class={label} for="lf-timing">When do you need it?</label>
    <select id="lf-timing" name="Timing" class={field}>
      {timingOptions.map((o) => <option value={o}>{o}</option>)}
    </select>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="lf-name">Your name</label>
      <input id="lf-name" name="Name" type="text" class={field} autocomplete="name" required />
    </div>
    <div>
      <label class={label} for="lf-phone">Phone or WhatsApp</label>
      <input id="lf-phone" name="Phone" type="tel" inputmode="tel" class={field} autocomplete="tel" placeholder="e.g. 8123 4567" required />
    </div>
  </div>

  {/* Honeypot. Real people never fill this in; bots usually do. */}
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />

  <button
    type="submit"
    data-lead-submit
    class="w-full rounded-lg bg-brand px-6 py-4 text-base font-semibold text-white transition-colors hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
  >
    Ask for a quote
  </button>

  <p data-lead-status role="status" aria-live="polite" class="hidden text-sm font-medium"></p>

  <p class="text-xs leading-relaxed text-ink-faint">
    Your details go to the team behind {company.parentBrand}, which passes them to the
    partner handyman who will quote you. They are used only for this enquiry and are not
    sold. See the
    <a href={urls.privacy()} class="underline underline-offset-2">privacy policy</a>.
  </p>
</form>

<div data-lead-success hidden class="rounded-card border border-brand/30 bg-brand-light/60 p-6 sm:p-8">
  <h2 class="text-xl font-semibold text-ink sm:text-2xl">Thank you. Your enquiry is on its way.</h2>
  <p class="mt-3 leading-relaxed text-ink-muted">
    We usually reply within one working day. We'll pass your enquiry to a partner
    handyman, who will contact you to ask about the job and give you a quote.
  </p>
  <p class="mt-3 leading-relaxed text-ink-muted">
    There's nothing else you need to do. If you left something out, send another enquiry.
  </p>
  <button
    type="button"
    data-lead-again
    class="mt-6 rounded-lg bg-surface px-5 py-2.5 text-sm font-semibold text-brand ring-1 ring-line-strong transition-colors hover:bg-brand-light"
  >
    Send another enquiry
  </button>
</div>
</div>

<script is:inline define:vars={{ FORM_ENDPOINT, subject, site }}>
  (function () {
    var form = document.querySelector('[data-lead-form]');
    if (!form) return;

    var status = form.querySelector('[data-lead-status]');
    var submit = form.querySelector('[data-lead-submit]');
    var success = document.querySelector('[data-lead-success]');
    var again = success && success.querySelector('[data-lead-again]');

    function value(name) {
      var el = form.elements.namedItem(name);
      return el && 'value' in el ? String(el.value).trim() : '';
    }

    function ticked() {
      return Array.prototype.slice
        .call(form.querySelectorAll('input[name="Jobs"]:checked'))
        .map(function (el) { return el.value; });
    }

    function show(message, ok) {
      status.textContent = message;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--color-positive)' : 'var(--color-warning)';
    }

    function showSuccess() {
      form.hidden = true;
      success.hidden = false;
      success.setAttribute('tabindex', '-1');
      success.focus({ preventScroll: true });
      success.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    if (again) {
      again.addEventListener('click', function () {
        success.hidden = true;
        form.hidden = false;
        form.scrollIntoView({ block: 'start', behavior: 'smooth' });
      });
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      // Silently "succeed" for bots rather than telling them they were caught.
      if (value('_honey')) {
        showSuccess();
        return;
      }

      var jobs = ticked();
      var data = {
        Jobs: jobs.join(', '),
        Details: value('Details'),
        Property: value('Property'),
        Area: value('Area') || '-',
        Timing: value('Timing'),
        Name: value('Name'),
        Phone: value('Phone'),
      };

      if (!jobs.length || !data.Details || !data.Property || !data.Name || data.Phone.replace(/\D/g, '').length < 8) {
        show('Please tick at least one job, describe it, choose the property type, and add your name and a phone number.', false);
        return;
      }

      submit.disabled = true;
      show('Sending…', true);

      data._subject = subject;
      data._template = 'table';
      data.Site = site;
      data.Page = window.location.pathname;

      fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (res) {
          // FormSubmit answers 200 even when it refuses a submission (an
          // unactivated form returns success: "false"), so check the body.
          var ok = res && (res.success === true || res.success === 'true');
          if (!ok) throw new Error((res && res.message) || 'rejected');

          // The site's one key event. Genuine delivery only.
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', {
              page_path: window.location.pathname,
              jobs: data.Jobs,
              property_type: data.Property,
            });
          }
          form.reset();
          submit.disabled = false;
          status.classList.add('hidden');
          showSuccess();
        })
        .catch(function () {
          // Keep everything they typed, so they can simply try again.
          submit.disabled = false;
          show('Sorry, your enquiry did not send. Everything you typed is still here, so please try again in a moment.', false);
        });
    });
  })();
</script>
