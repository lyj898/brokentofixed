---
/**
 * /about/
 *
 * Says plainly that this is a matching service run by the team behind Junk to
 * Clear. The one link to Junk to Clear's home page lives here, not in the
 * footer. Nothing about licences: the user's call, 5 Oct 2026.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';

import { company } from '../lib/data';
import { urls } from '../lib/urls';
import { meta } from '../lib/seo';

const path = urls.about();
const { title, description } = meta(
  'About BrokenToFixed | Run by the Team Behind Junk to Clear',
  'BrokenToFixed is a handyman matching service in Singapore, run by the team behind Junk to Clear. Partner handymen quote and do the work.',
);
---

<BaseLayout title={title} description={description} path={path} crumbs={[{ name: 'About', path }]}>
  <section class="border-b border-line bg-surface">
    <div class="wrap grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        <h1 class="text-3xl font-semibold sm:text-4xl lg:text-5xl">About {company.tradingName}</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">
          {company.tradingName} is a handyman matching service for homes and offices in
          Singapore, run by the team behind
          <a href={company.parentBrandUrl} class="text-brand underline underline-offset-2">{company.parentBrand}</a>.
        </p>
      </div>
      <img
        src="/illo/about.svg"
        alt="An enquiry travelling from a person at a desk with a laptop to a handyman holding a toolbox"
        width="480"
        height="300"
        fetchpriority="high"
        decoding="async"
        class="mx-auto h-auto w-full max-w-sm"
      />
    </div>
  </section>

  <Section narrow>
    <div class="prose-bf text-ink-muted">
      <h2 class="text-ink">What we do</h2>
      <p>
        Getting small jobs done usually means asking around, messaging several people and
        explaining the same job each time. {company.tradingName} makes it one step: you tell
        us what needs fixing and where, and we pass your enquiry to a partner handyman who
        takes on that kind of job.
      </p>
      <p>
        The handyman contacts you, gives you its quote and, if you go ahead, does the work.
        {company.tradingName} doesn’t do repairs itself.
      </p>

      <h2 class="text-ink">Who we are</h2>
      <p>
        {company.tradingName} is run by the team behind {company.parentBrand}, which has
        handled disposal and clearance jobs for households and businesses in Singapore since
        {company.yearEstablished}. The same team reads every enquiry that comes through this
        site and passes it on.
      </p>

      <h2 class="text-ink">What we won’t do</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Publish prices we can’t stand behind. The handyman quotes once it knows the job.</li>
        <li>Post reviews or ratings we haven’t collected.</li>
        <li>Sell your details. They go only to the handyman who will quote you.</li>
        <li>Take on renovation through this site. That’s a different kind of job.</li>
      </ul>
    </div>

    <p class="mt-10 text-ink-muted">
      See <a href={urls.howItWorks()} class="text-brand underline underline-offset-2">how it works</a>,
      or go straight to <a href={urls.handyman()} class="text-brand underline underline-offset-2">handyman jobs</a>.
    </p>
  </Section>

  <CtaBand heading="Tell us what needs fixing" body="One enquiry, passed to a partner handyman who will quote you." />
</BaseLayout>
